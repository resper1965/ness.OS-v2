# Frontend - O Dashboard n.infraops + ness.OS Solution Page
hub.ness.com.br {
    # ness.OS Solution Page — /platform
    handle /platform* {
        root * /srv/public
        rewrite * /index.html
        file_server
        encode gzip
        header Cache-Control "public, max-age=3600"
    }

    # React App — tudo o resto
    handle {
        reverse_proxy frontend:3000
    }
}

# API Backend & IA Proxy
api.ness.com.br {
    reverse_proxy api:8000
}

# Keep AIOps Dashboard
events.hub.ness.com.br {
    reverse_proxy keep-frontend:3000
}

# Evolution API (WhatsApp Center)
waba.ness.com.br {
    reverse_proxy evolution-api:8080
}
