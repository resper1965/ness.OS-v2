# ================================================
# n.infraops — Variáveis de Ambiente
# Copie para .env e preencha os valores
# ================================================

# --- App ---
NINF_APP_NAME=n.infraops
NINF_DEBUG=false

# --- PostgreSQL (TimescaleDB + pgvector) ---
NINF_DB_PASSWORD=
NINF_DATABASE_URL=postgresql+asyncpg://nessops:${NINF_DB_PASSWORD:-changeme}@postgres:5432/nessops

# --- Redis ---
NINF_REDIS_URL=redis://redis:6379/0
NINF_CELERY_BROKER_URL=redis://redis:6379/1
NINF_CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Zabbix ---
NINF_ZABBIX_URL=https://zabbix.ness.com.br/api_jsonrpc.php
NINF_ZABBIX_API_TOKEN=

# --- Gemini AI ---
NINF_GEMINI_API_KEY=
NINF_GEMINI_MODEL=gemini-2.5-flash

# --- n8n ---
NINF_N8N_PASSWORD=
NINF_N8N_BASE_URL=http://n8n:5678
NINF_N8N_WEBHOOK_INCIDENT=/webhook/incident-created
NINF_N8N_WEBHOOK_POSTMORTEM=/webhook/postmortem-ready

# --- DeskManager ---
NINF_DESKMANAGER_API_URL=https://api.deskmanager.com.br/v2
NINF_DESKMANAGER_API_TOKEN=
NINF_DESKMANAGER_OPERATOR_ID=

# --- Evolution API (WhatsApp) ---
NINF_EVOLUTION_API_URL=http://evolution:8080
NINF_EVOLUTION_INSTANCE=noc-alerts
NINF_EVOLUTION_API_KEY=
NINF_WHATSAPP_NOC_GROUP_ID=

# --- RMM Providers ---
NINF_DATTO_API_KEY=
NINF_DATTO_API_SECRET=
NINF_DATTO_API_URL=https://pinotage-api.centrastage.net
NINF_ATERA_API_KEY=
NINF_ATERA_API_URL=https://app.atera.com/api/v3

# --- Dashboard ---
NINF_DASHBOARD_BASE_URL=https://infraops.ness.com.br
