# ================================================
# n.infraops — Variáveis de Ambiente
# Copie para .env e preencha os valores
# ================================================

# --- App ---
NINF_APP_NAME=n.infraops
NINF_DEBUG=false

# --- JWT Auth (FASE 4) ---
# Gere um secret forte: openssl rand -hex 32
NINF_JWT_SECRET=
NINF_JWT_EXPIRE_HOURS=8
# Cookie HttpOnly do Hub. Use false somente em desenvolvimento local sem HTTPS.
NINF_SESSION_COOKIE_SECURE=true

# --- PostgreSQL (TimescaleDB + pgvector) ---
NINF_DB_PASSWORD=
NINF_DATABASE_URL=

# --- Redis ---
NINF_REDIS_URL=redis://redis:6379/0
NINF_CELERY_BROKER_URL=redis://redis:6379/1
NINF_CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Zabbix ---
NINF_ZABBIX_URL=https://zabbix.ness.com.br/api_jsonrpc.php
NINF_ZABBIX_VERIFY_CERT=true
NINF_ZABBIX_API_TOKEN=""

# --- Gemini AI ---
NINF_GEMINI_API_KEY=
NINF_GEMINI_MODEL=gemini-2.5-flash

# --- n8n ---
NINF_N8N_PASSWORD=
NINF_N8N_BASE_URL=https://n8n.ness.com.br
NINF_N8N_WEBHOOK_INCIDENT=/webhook/incident-created
NINF_N8N_WEBHOOK_POSTMORTEM=/webhook/postmortem-ready
NINF_SMTP_SENDER=noc-alerts@ness.com.br
NINF_TICKET_EMAIL=suporte@ness.com.br

# --- DeskManager ---
NINF_DESKMANAGER_API_URL=https://api.deskmanager.com.br/v2
NINF_DESKMANAGER_API_TOKEN=
NINF_DESKMANAGER_OPERATOR_ID=

# --- GLPI ---
# Private Docker-network route. Do not point machine integrations at the SSO frontend.
NINF_GLPI_DB_ROOT_PASSWORD=
NINF_GLPI_DB_PASSWORD=
NINF_GLPI_URL=http://ninf-glpi/apirest.php
NINF_GLPI_APP_TOKEN=
NINF_GLPI_USER_TOKEN=
NINF_GLPI_INFRA_CATEGORY_ID=0
NINF_GLPI_SECURITY_CATEGORY_ID=0

# --- Evolution API (WhatsApp) ---
NINF_EVOLUTION_API_URL=https://waba.ness.com.br
NINF_EVOLUTION_INSTANCE=noc-alerts
NINF_EVOLUTION_API_KEY=
NINF_WHATSAPP_NOC_GROUP_ID=
# Enable only after n8n secret and UAT are verified.
NINF_ALERT_NOTIFICATIONS_ENABLED=false

# --- RMM Providers ---
NINF_DATTO_API_KEY=
NINF_DATTO_API_SECRET=
NINF_DATTO_API_URL=https://pinotage-api.centrastage.net
NINF_ATERA_API_KEY=
NINF_ATERA_API_URL=https://app.atera.com/api/v3

# --- Dashboard ---
NINF_DASHBOARD_BASE_URL=https://hub.ness.com.br

# --- Authentik / OIDC ---
NINF_AUTHENTIK_SECRET_KEY=
NINF_AUTHENTIK_EMAIL_FROM=ness. identidade <identidade@ness.com.br>
NINF_OIDC_ENABLED=false
NINF_OIDC_JWKS_URL=https://sso.ness.com.br/application/o/hub/jwks/
NINF_OIDC_TOKEN_URL=https://sso.ness.com.br/application/o/token/
NINF_OIDC_CLIENT_ID=hub-ness
NINF_OIDC_CLIENT_SECRET=
NINF_OIDC_ISSUER=https://sso.ness.com.br/application/o/hub/

# --- E-mail transacional / Resend ---
# Segredo somente no runtime. Nunca grave a chave real neste arquivo ou no Git.
# O Hub permanece fail-closed até que cada evento tenha uma fonte de verdade.
NINF_TRANSACTIONAL_EMAIL_ENABLED=false
NINF_TRANSACTIONAL_EMAIL_FROM=ness.OS Hub <hub@ness.com.br>
NINF_RESEND_API_URL=https://api.resend.com
NINF_EMAIL_TIMEOUT_SECONDS=10
NINF_EMAIL_MAX_ATTEMPTS=3
NINF_SMTP_HOST=smtp.resend.com
NINF_SMTP_PORT=587
NINF_SMTP_USERNAME=resend
NINF_RESEND_API_KEY=
NINF_SMTP_USE_TLS=true
NINF_SMTP_USE_SSL=false

# --- Webhooks e bootstrap local de emergência ---
NINF_WEBHOOK_API_KEY=
# Shared backend-to-n8n secret (at least 32 random characters).
NINF_N8N_WEBHOOK_API_KEY=
# Somente DEBUG/local; não configure em produção normal.
NINF_SEED_ADMIN_PASSWORD=

# --- Threat intelligence ---
NINF_VIRUSTOTAL_API_KEY=
NINF_ABUSEIPDB_API_KEY=
NINF_MISP_URL=https://misp.ness.com.br
NINF_MISP_API_KEY=replace-with-misp-api-key
NINF_MISP_VERIFY_CERT=true

# --- Contabo read-only ---
NINF_CONTABO_CLIENT_ID=
NINF_CONTABO_CLIENT_SECRET=
NINF_CONTABO_API_USER=
NINF_CONTABO_API_PASSWORD=
