# GLPI Service Desk with Authentik Forward Auth SSO
n-ticket.ness.com.br {
    # Autenticar via Authentik Forward Auth
    forward_auth authentik-server:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid
    }

    # Injetar o username do Authentik como REMOTE_USER para o GLPI
    request_header X-Remote-User {http.request.header.X-Authentik-Username}
    request_header Remote-User {http.request.header.X-Authentik-Username}

    reverse_proxy ninf-glpi:80
}

# Psono Community — temporary AIOps placement; application authentication is native.
cofre.ness.com.br {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        -Server
    }

    @runtime_branding path / /index.html /config.json /css/custom.css /service-worker.js /js/service-worker-load.js
    header @runtime_branding {
        >Cache-Control "private, max-age=0, no-cache, no-store, must-revalidate"
        >Pragma "no-cache"
        >Expires "0"
    }

    # Temporary migration signal. Remove after active clients receive the
    # self-retiring service worker; it clears HTTP cache, not cookies/storage.
    @branding_cache_reset path /server/info/ /server/user/status/
    header @branding_cache_reset Clear-Site-Data "\"cache\""

    reverse_proxy ness-psono:80
}
