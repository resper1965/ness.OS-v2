{$PSONO_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        -Server
    }

    @runtime_branding path / /index.html /config.json /css/custom.css /service-worker.js /js/service-worker-load.js /js/language-default.js /portal /portal/ /portal/index.html /portal/config.json
    header @runtime_branding {
        >Cache-Control "private, max-age=0, no-cache, no-store, must-revalidate"
        >Pragma "no-cache"
        >Expires "0"
    }

    reverse_proxy psono:80
}
