# Install as /etc/ness-os/backup-s3.env, owned by root:root, mode 0600.
# Use an HTTPS origin built from the s3Url returned by Contabo (no path).
CONTABO_S3_ENDPOINT=
CONTABO_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=

# Stable lowercase identifier; it creates an isolated repository prefix.
NESS_BACKUP_HOST_ID=

# Safety minimums are enforced by the script: keep >= 1, check 1..100 percent.
RESTIC_KEEP_LAST=14
RESTIC_CHECK_PERCENT=5
