# Copiar para /etc/ness-os/zabbix-saml.env (nao versionar o real)
TENANT_ID=00000000-0000-0000-0000-000000000000
DOMAIN=example.com
SP_ENTITY=https://zabbix-web.example.com
CERT_SRC=/etc/ness-os/entra-saml.crt
# usernames atuais (sem dominio); viram usuario@DOMAIN
SSO_USERS="alice bob carol"
# subconjunto sem senha local (quebra de vidro fica fora). Padrao: todos de SSO_USERS
LOCK_USERS="bob carol"
# opcional: nova senha do akadmin (1 linha)
#AKADMIN_PASS_FILE=/etc/ness-os/akadmin.pass
