# ============================================================================
# Configuração otimizada do MariaDB para Zabbix
# Gerenciado pelo Ansible - NÃO editar manualmente
# Servidor de referência: 30GB RAM | Debian 12 (Bookworm) | MariaDB 10.11
# ============================================================================

[mysqld]

# --------------------------------------------------------------------------
# Segurança de rede
# Aceita conexões apenas do localhost (127.0.0.1)
# --------------------------------------------------------------------------
bind-address = 127.0.0.1

# --------------------------------------------------------------------------
# InnoDB - Pool de buffers
# Regra geral: 50-70% da RAM total para o buffer pool
# Para 30GB RAM: 16GB é um valor seguro, deixando margem para o SO e Zabbix
# --------------------------------------------------------------------------
innodb_buffer_pool_size         = {{ mariadb_innodb_buffer_pool_size | default('16G') }}
innodb_buffer_pool_instances    = {{ mariadb_innodb_buffer_pool_instances | default('8') }}

# --------------------------------------------------------------------------
# InnoDB - Log de transações
# Arquivos de log maiores melhoram performance de escrita mas aumentam
# o tempo de recuperação em caso de crash
# --------------------------------------------------------------------------
innodb_log_file_size            = {{ mariadb_innodb_log_file_size | default('1G') }}

# --------------------------------------------------------------------------
# InnoDB - Método de flush e commit
# O_DIRECT: evita double buffering entre InnoDB e o cache do SO
# flush_log_at_trx_commit = 2: melhor performance com risco mínimo
#   (flush a cada segundo, não a cada transação)
# --------------------------------------------------------------------------
innodb_flush_method             = O_DIRECT
innodb_flush_log_at_trx_commit  = 2

# --------------------------------------------------------------------------
# InnoDB - Capacidade de I/O
# Valores adequados para SSDs ou storage de alta performance
# --------------------------------------------------------------------------
innodb_io_capacity              = 2000
innodb_io_capacity_max          = 4000

# --------------------------------------------------------------------------
# InnoDB - Threads de leitura e escrita
# 8 threads cada é adequado para servidores com múltiplos cores
# --------------------------------------------------------------------------
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8

# --------------------------------------------------------------------------
# Conexões e threads
# max_connections: limite de conexões simultâneas ao banco
# thread_cache_size: threads mantidas em cache para reutilização
# --------------------------------------------------------------------------
max_connections                 = {{ mariadb_max_connections | default('300') }}
thread_cache_size               = {{ mariadb_thread_cache_size | default('64') }}

# --------------------------------------------------------------------------
# Tabelas temporárias em memória
# Tabelas temporárias acima destes limites são gravadas em disco
# --------------------------------------------------------------------------
tmp_table_size                  = {{ mariadb_tmp_table_size | default('256M') }}
max_heap_table_size             = {{ mariadb_max_heap_table_size | default('256M') }}

# --------------------------------------------------------------------------
# Buffers de operação
# key_buffer_size: buffer para índices MyISAM (usado por tabelas internas)
# sort/read/join_buffer: buffers por sessão para operações de consulta
# --------------------------------------------------------------------------
key_buffer_size                 = {{ mariadb_key_buffer_size | default('64M') }}
sort_buffer_size                = {{ mariadb_sort_buffer_size | default('4M') }}
read_buffer_size                = {{ mariadb_read_buffer_size | default('4M') }}
read_rnd_buffer_size            = {{ mariadb_read_rnd_buffer_size | default('4M') }}
join_buffer_size                = {{ mariadb_join_buffer_size | default('4M') }}

# --------------------------------------------------------------------------
# Cache de tabelas abertas
# Valor alto é recomendado para o Zabbix que utiliza muitas tabelas
# --------------------------------------------------------------------------
table_open_cache                = {{ mariadb_table_open_cache | default('4096') }}

# --------------------------------------------------------------------------
# Conjunto de caracteres padrão
# utf8mb4: suporte completo a Unicode (incluindo emojis e caracteres CJK)
# --------------------------------------------------------------------------
character-set-server            = utf8mb4
collation-server                = utf8mb4_general_ci

# --------------------------------------------------------------------------
# Logs binários e slow query
# expire_logs_days: retenção de 3 dias para logs binários
# slow_query_log: registra consultas que excedem long_query_time
# --------------------------------------------------------------------------
expire_logs_days                = 3
slow_query_log                  = 1
slow_query_log_file             = /var/log/mysql/mariadb-slow.log
long_query_time                 = {{ mariadb_long_query_time | default('3') }}

# --------------------------------------------------------------------------
# Nível de avisos no log de erros
# log_warnings = 2: registra avisos detalhados (conexões abortadas, etc.)
# --------------------------------------------------------------------------
log_warnings                    = 2

# --------------------------------------------------------------------------
# Resolução de nomes
# skip-name-resolve: desabilita resolução DNS reversa para conexões
# Melhora performance e evita problemas com DNS lento
# --------------------------------------------------------------------------
skip-name-resolve

# --------------------------------------------------------------------------
# Limite de arquivos abertos
# Valor alto necessário para table_open_cache elevado
# --------------------------------------------------------------------------
open_files_limit                = 65535

# ============================================================================
# Configuração do cliente MariaDB
# ============================================================================

[client]

# --------------------------------------------------------------------------
# Charset padrão para conexões do cliente
# Deve ser consistente com o charset do servidor
# --------------------------------------------------------------------------
default-character-set           = utf8mb4
