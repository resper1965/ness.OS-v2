{# ========================================================================== #}
{# Configuração do rclone para Contabo Object Storage (compatível com S3)    #}
{# Gerado automaticamente pelo Ansible - NÃO editar manualmente.            #}
{# ========================================================================== #}

[contabo]
type = s3
provider = Other
access_key_id = {{ contabo_s3_access_key }}
secret_access_key = {{ contabo_s3_secret_key }}
endpoint = {{ contabo_s3_endpoint }}
acl = private
force_path_style = true
no_check_bucket = true
