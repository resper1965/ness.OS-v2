#!/usr/bin/env bash
# Usage: infra/bin/ansible <ansible-playbook|ansible-lint|ansible-inventory> [args]
# Runs from infra/.venv, built from requirements-iac.txt on first use.
set -euo pipefail
INFRA="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$INFRA/.venv"
export ANSIBLE_COLLECTIONS_PATH="$VENV/collections"
export ANSIBLE_CONFIG="$INFRA/ansible/ansible.cfg"
if [ ! -f "$VENV/.ready" ]; then
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q -r "$INFRA/requirements-iac.txt"
  "$VENV/bin/ansible-galaxy" collection install ansible.posix:==2.2.2 community.general:==12.0.0 community.mysql:==5.0.2 community.docker:==4.8.3 >/dev/null
  touch "$VENV/.ready"
fi
cmd="${1:?usage: ansible <command> [args]}"
shift
exec "$VENV/bin/$cmd" "$@"
